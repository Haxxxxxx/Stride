rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User data: owner can read freely, write with field restrictions ---
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // betaValidated is set by Cloud Functions (Admin SDK) only — prevent client bypass
      allow create: if request.auth != null && request.auth.uid == uid
        && !("betaValidated" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["betaValidated"]);

      // Subcollections under user doc
      match /personalization/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /behaviorState/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /programs/{programId} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid;
      }
      match /workoutLogs/{logId} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
      }
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /settings/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // --- Challenges: anyone can read, creator can update, anyone can increment/decrement participantCount ---
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantCount", "updatedAt"])
                && (request.resource.data.participantCount == resource.data.participantCount + 1
                    || request.resource.data.participantCount == resource.data.participantCount - 1)));

      // Participants manage their own docs
      match /participants/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // --- Squads: anyone can read, only creator can update ---
    match /squads/{squadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      // Creator can update, OR any member can increment/decrement memberCount by exactly 1
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberCount", "updatedAt"])
                && (request.resource.data.memberCount == resource.data.memberCount + 1
                    || request.resource.data.memberCount == resource.data.memberCount - 1)));

      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // --- Wallet index: admin SDK only (Cloud Function walletSignIn) ---
    match /walletIndex/{walletAddress} {
      allow read, write: if false;
    }

    // --- Rate limiting: admin SDK only (Cloud Functions) ---
    match /_rateLimit/{docId} {
      allow read, write: if false;
    }

    // --- Beta codes: can read specific code (get), only mark as used if not already used ---
    match /betaCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow update: if request.auth != null
        && !resource.data.used
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid;
    }
  }
}
